# Etap budowania
FROM node:25-bookworm-slim as node-builder
WORKDIR /app
ARG VITE_API_URL=https://api.wartkinurt.pl
ENV VITE_API_URL=${VITE_API_URL}
COPY package*.json ./
COPY vite.config.js ./
COPY resources/js ./resources/js
COPY resources/css ./resources/css
RUN npm ci && npm run build

# Etap composer
FROM composer:latest as composer
WORKDIR /app
COPY composer.json composer.lock ./
COPY packages ./packages
RUN composer install --no-dev --optimize-autoloader --no-interaction

# Etap produkcyjny
FROM php:8.3-fpm-bookworm

# Instalacja zależności systemowych i Node.js 23
RUN apt-get update && apt-get install -y \
    wget \
    gnupg \
    ca-certificates \
    apt-transport-https \
    software-properties-common \
    && mkdir -p /etc/apt/keyrings \
    && wget -qO- https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_23.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y nodejs

# Instalacja zależności dla PHP, Chromium i Browsershot
RUN apt-get install -y \
    libzip-dev \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libwebp-dev \
    chromium \
    supervisor \
    netcat-openbsd \
    # Zależności dla Chromium/Puppeteer
    libnss3 \
    libxss1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libgtk-3-0 \
    libgbm1 \
    libxshmfence1 \
    && docker-php-ext-configure gd \
        --with-freetype \
        --with-jpeg \
        --with-webp \
    && docker-php-ext-install -j$(nproc) \
        pdo_mysql \
        zip \
        gd \
        bcmath \
        opcache \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Instalacja puppeteer globalnie
RUN npm install -g puppeteer@latest

RUN sed -i 's/listen = 127.0.0.1:9000/listen = 0.0.0.0:9000/' /usr/local/etc/php-fpm.d/www.conf

# Konfiguracja Browsershot
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    BROWSERSHOT_NODE_BINARY=/usr/bin/node \
    BROWSERSHOT_NPM_BINARY=/usr/bin/npm \
    BROWSERSHOT_CHROME_PATH=/usr/bin/chromium \
    CHROME_PATH=/usr/bin/chromium

# Konfiguracja PHP i OPcache
COPY docker/php/prod.ini /usr/local/etc/php/conf.d/
COPY docker/php/opcache.ini /usr/local/etc/php/conf.d/

# Konfiguracja supervisora
COPY docker/supervisord.conf /etc/supervisor/conf.d/

# Kopiowanie aplikacji
WORKDIR /var/www/html
COPY --chown=www-data:www-data . .
COPY --from=node-builder --chown=www-data:www-data /app/public/build public/build
COPY --from=composer --chown=www-data:www-data /app/vendor vendor/

# Tworzenie .env
RUN cp .env.example .env

# Kopiowanie skryptu produkcyjnego
COPY docker/scripts/prod-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/prod-entrypoint.sh

# Czyszczenie i ustawienie uprawnień
RUN mkdir -p storage/framework/{cache,views,sessions} storage/logs bootstrap/cache && \
    chown -R www-data:www-data storage bootstrap/cache && \
    chmod -R 755 storage bootstrap/cache && \
    chmod -R 775 storage/framework storage/logs

# Konfiguracja zmiennych środowiskowych
ENV APP_ENV=production \
    APP_DEBUG=false \
    COMPOSER_ALLOW_SUPERUSER=1 \
    PHP_OPCACHE_VALIDATE_TIMESTAMPS=0 \
    PHP_OPCACHE_MAX_ACCELERATED_FILES=10000 \
    PHP_OPCACHE_MEMORY_CONSUMPTION=192

EXPOSE 9000

CMD ["/usr/local/bin/prod-entrypoint.sh"]
