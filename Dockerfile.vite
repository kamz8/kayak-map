# docker/vite/Dockerfile.optimized
FROM node:18-alpine AS development

WORKDIR /app

# Zainstaluj zależności systemowe
RUN apk add --no-cache \
    curl \
    git \
    python3 \
    make \
    g++

# Skopiuj package.json
COPY package*.json ./

# Instalacja zależności
RUN npm ci --legacy-peer-deps

# Skopiuj resztę aplikacji
COPY . .

# Ustaw zmienne środowiskowe
ENV DOCKER_ENV=true
ENV NODE_ENV=development
ENV HOST=0.0.0.0
ENV PORT=5173

# Expose porty
EXPOSE 5173
EXPOSE 24678

# Uruchom Vite
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173", "--config", "vite.config.js"]
